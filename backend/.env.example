# Server Configuration
PROJECT_NAME="SeoSensing SEO & AEO Optimization Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=False
PORT=8000
HOST="0.0.0.0"
# Skip create_all/ALTER TABLE startup DDL (Alembic owns schema). Default False = dev SQLite convenience.
SKIP_STARTUP_DDL=False

# CORS Configuration (JSON array of strings) — never "*" for authenticated APIs.
# dev: ["https://dev.rank.zobay.in","http://localhost:3000"]
# staging: ["https://staging.rank.zobay.in"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Dev/staging: PostgreSQL — async app URL + sync Alembic URL.
# Example: postgresql+psycopg://user:pass@host:5432/db
# Local SQLite dev only: sqlite+aiosqlite:///./dmos_dev.db (never in deployment configs)
DATABASE_URL=postgresql+psycopg://dmos_user:CHANGE_ME@localhost:5432/dmos_seo_aeo
SYNC_DATABASE_URL=postgresql://dmos_user:CHANGE_ME@localhost:5432/dmos_seo_aeo

# Redis Configuration (Job queue / cache preparation)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Crawler Configuration (Phase 2)
CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=5
CRAWL_TIMEOUT=15
CRAWL_CONCURRENCY=5
CRAWL_MAX_RETRIES=2
CRAWL_MAX_RESPONSE_SIZE=10485760
CRAWLER_USER_AGENT="SeoSensingBot/1.0 (+https://seosensing.io/bot; SEO & AEO Audit Engine)"

# Security — set via environment; known defaults are rejected at startup.
SECRET_KEY=
# Dev-only auth bootstrap (POST /api/v1/dev/auth/token). Empty = disabled. Never set in staging/production.
DEV_AUTH_SECRET=

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CURRENCY=USD

# Razorpay Subscription Plan IDs (Optional)
RAZORPAY_STARTER_PLAN_ID=plan_starter_id
RAZORPAY_GROWTH_PLAN_ID=plan_growth_id
RAZORPAY_PRO_PLAN_ID=plan_pro_id
RAZORPAY_BUSINESS_PLAN_ID=plan_business_id
RAZORPAY_AGENCY_PLAN_ID=plan_agency_id

# Central AI Intelligence Layer (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
