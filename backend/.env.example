# Server Configuration
PROJECT_NAME="SeoSensing SEO & AEO Optimization Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# For PostgreSQL: postgresql+psycopg://dmos_user:dmos_secret_password@localhost:5432/dmos_seo_aeo
# For local SQLite development/testing: sqlite+aiosqlite:///./dmos_dev.db
DATABASE_URL=sqlite+aiosqlite:///./dmos_dev.db
SYNC_DATABASE_URL=sqlite:///./dmos_dev.db

# Redis Configuration (Job queue / cache preparation)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Crawler Configuration (Phase 2)
CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=5
CRAWL_TIMEOUT=15
CRAWL_CONCURRENCY=5
CRAWL_MAX_RETRIES=2
CRAWL_MAX_RESPONSE_SIZE=10485760
CRAWLER_USER_AGENT="SeoSensingBot/1.0 (+https://seosensing.io/bot; SEO & AEO Audit Engine)"

# Security
SECRET_KEY="dmos-phase-1-super-secret-key-change-in-production"

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CURRENCY=USD

# Razorpay Subscription Plan IDs (Optional)
RAZORPAY_STARTER_PLAN_ID=plan_starter_id
RAZORPAY_GROWTH_PLAN_ID=plan_growth_id
RAZORPAY_PRO_PLAN_ID=plan_pro_id
RAZORPAY_BUSINESS_PLAN_ID=plan_business_id
RAZORPAY_AGENCY_PLAN_ID=plan_agency_id

